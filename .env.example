# Path variables for sc_classification (resolved by src/sc_classification/utils/paths.py).
#
# Nothing auto-loads this file. Export the variables in your shell (profile or session),
# or copy the lines you need into a direnv .envrc as `export NAME=value`.
# Every variable is optional; unset or empty means "use the default". On the lab server
# all defaults already resolve, so nothing needs to be set there.
# Values may use $HOME and other $VARS; relative values are relative to the working dir.
# Never commit a filled-in copy that contains machine-specific paths.
#
# Check what resolves (paths, exists flags, git state, pytest/dash):
#   python -m sc_classification.utils.paths

# Repo root (this clone of sc_classification).
# Default: auto-detected by walking up to the pyproject.toml with name = "sc_classification".
# SC_REPO_ROOT=

# Directory that holds experiment dirs.
# Default: <repo>/experiments
# SC_EXPERIMENT_ROOT=

# Experiment dir name inside SC_EXPERIMENT_ROOT.
# Default: canonical_experiment_id from scripts/mrd_stage0_2/research/study_config.json
# SC_EXPERIMENT_ID=

# Umbrella data directory (raw cohort AnnData, gene sets, resource caches).
# Default: <repo>/../data (the umbrella layout)
# SC_DATA_ROOT=

# Raw cohort AnnData file (override only if it lives outside SC_DATA_ROOT).
# Default: SC_DATA_ROOT/<raw_h5ad_relpath from research/study_config.json>
# SC_COHORT_H5AD=

# Example for a collaborator whose experiment copy lives elsewhere:
# export SC_EXPERIMENT_ROOT="$HOME/<dir holding experiment dirs>"
# export SC_DATA_ROOT="$HOME/<umbrella data dir>"
